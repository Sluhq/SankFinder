# ŠankFinder Server Environment Configuration Example
PORT=8080
ADMIN_USER=anze
# Format: <salt_hex>:<scrypt_hash_hex> (generirano z node:crypto scryptSync)
ADMIN_PASSWORD_HASH=
# 32-bajtni naključni heksadecimalni ključ za AES-256-GCM šifriranje podatkov v SQLite bazi
SERVER_MASTER_KEY=
# Skupni skrivni ključ za HMAC-SHA256 podpisovanje API zahtevkov med aplikacijo in strežnikom
SHARED_APP_SECRET=
